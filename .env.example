# GitHub token (read-only public access is enough). Used ONLY by the hourly cron job.
GITHUB_TOKEN=

# Optional: enables Claude-generated categories + plain-language explanations.
# Without it, categories come from keyword mapping and the GitHub description is shown.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Protects /api/cron/refresh. Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# Set automatically when a Vercel Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public" – must match the access mode of your Blob store.
# BLOB_ACCESS=private

# Local development only: where snapshots are stored when no Blob token is set (default ./.data)
# DATA_DIR=
